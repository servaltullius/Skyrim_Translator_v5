<srx version="2.0" xmlns="http://www.lisa.org/srx20" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><header segmentsubflows="yes" cascade="yes"><formathandle type="start" include="no"/><formathandle type="end" include="yes"/><formathandle type="isolated" include="no"/></header><body><languagerules><languagerule languagerulename="Default">
  <!-- No-breaks for common abbreviations -->
  <rule break="no"><beforebreak>\sMr\.</beforebreak><afterbreak>\s[A-Z]</afterbreak></rule>
  <rule break="no"><beforebreak>\s[Ee]tc\.</beforebreak><afterbreak>\s[a-z]</afterbreak></rule>
  <rule break="no"><beforebreak>\s(?:[Ee]\.g|[Ii]\.e)\.</beforebreak><afterbreak>\s[a-z]</afterbreak></rule>
  <rule break="no"><beforebreak>\sp\.</beforebreak><afterbreak>\s\d</afterbreak></rule>

  <!-- Break after sentence punctuation, allowing closing quotes/brackets before the space+Upper -->
  <rule break="yes"><beforebreak>[.?!][\"'\)\]\}]*</beforebreak><afterbreak>\s+[A-Z]</afterbreak></rule>
  <!-- Fallback: simple punctuation + space + Uppercase -->
  <rule break="yes"><beforebreak>[.?!]</beforebreak><afterbreak>\s[A-Z]</afterbreak></rule>
</languagerule></languagerules><maprules><languagemap languagepattern=".*" languagerulename="Default"/></maprules></body></srx>
