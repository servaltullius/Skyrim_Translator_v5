<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XtrXmlTranslator.App.Views.Dialogs.GlossaryDialog"
        x:CompileBindings="False"
        Width="1000" Height="640" Title="용어집 편집">
  <Border Padding="12">
    <Grid RowDefinitions="Auto,* ,Auto">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="가져오기(CSV/TSV)" Click="OnImportClick"/>
      <Button Content="내보내기(CSV/TSV)" Click="OnExportClick"/>
      <Button Content="새 항목" Click="OnAddClick"/>
      <Button Content="삭제" Click="OnRemoveClick"/>
      <CheckBox Content="대소문자 구분 기본값" x:Name="DefaultCaseCheck"/>
    </StackPanel>

    <DataGrid Grid.Row="1" x:Name="Grid" ItemsSource="{Binding Items}"
              CanUserResizeColumns="True" IsReadOnly="False" GridLinesVisibility="All">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/>
        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
        <DataGridTemplateColumn Header="Type" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedItem="{Binding Type}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridCheckBoxColumn Header="Case" Binding="{Binding CaseSensitive}" Width="Auto"/>
        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="닫기" Click="OnCloseClick"/>
    </StackPanel>
    </Grid>
  </Border>
</Window>
